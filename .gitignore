# Caches and reproducibility noise
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
*.swp

# Regenerable trained weights (kept as a release artifact in artifacts/, but
# ignored on first commit so reviewers see one canonical binary)
gf256_hard_model_best.pt

# Local data downloads
data/tinyshakespeare.txt.tmp

# Run outputs (reproducible, regenerated by src/gf256_markov_lm_v6.py)
runs/
*.out

# Hermes plans from other sessions
.hermes/plans/*connect-four*

# ---- scratch / probe artefacts -----------------------------------------
# One-off diagnostic scripts written at the repo root or in tmp/ while
# chasing individual bugs. They document HOW a bug was found, which the
# curated regression tests in tmp/ already capture as assertions.
# Keep the curated tests; drop the throwaway probes.
_*.py
tmp/_*.py
tmp/probe_*.py
tmp/debug_*.py
tmp/audit_*.py
tmp/verify_*.py
tmp/eval_*.py
tmp/dump_*.py
tmp/print_*.py
tmp/scan_*.py
tmp/plot_*.py
tmp/*.log
tmp/*.json
tmp/*.txt
tmp/*.npz
tmp/*.pt

# Large data artifacts and per-run logs
*.npz
V1*.TXT
V*_TRAIN_LOG.TXT
PLAN_*.md

# ---- private training corpora -------------------------------------------
# The Connect Four corpus is private: it was generated locally and is NOT
# published. It must never be committed by accident. (27 MB of solver-labelled
# games; the public release ships the *checkpoint*, never the corpus.)
data/corpus_c4_bytes.txt
data/corpus_*.txt
data/*sidecar*
data/*targets*.npy
data/*.npy

# ---- hard-residual LM line: corpora and checkpoints --------------------
# The enwik8 / smollm corpora are reproducible from the download commands in
# RESEARCH_STATUS.md section 7 and are far too large to publish here.
data/enwik8
data/enwik8.zip
data/enwik8.train
data/enwik8.valid
data/enwik8.test
data/smollm_subset_*.txt
data/corpus_c4_bytes.txt

# Trained LM checkpoints are large (150 MB - 1.1 GB each). The paper ships the
# measured numbers and the scripts; the weights live on Hugging Face.
runs/
runs_tiny/
paper_tiny/
*.pt
!release/artifacts/*.pt

# Stale snapshots of the LM scripts taken by earlier agent runs. The root
# copies are canonical (they are newer and carry the gold2/rms-dyn stages).
f2/
fable/

# Search-stage scratch: one 106 MB checkpoint plus per-seed logs. The
# measured settings live in search/*/search.md and results.csv, which are
# kept.
search/web/runs/
search/web/logs/

# Scratch under tmp/ and paper/: the curated regression tests in tmp/ are
# tracked, but the one-off probes, deploy stages and duplicated snapshots
# are not. Only the untracked remainder is listed here.
tmp/_*
tmp/*.gif
tmp/*.html
tmp/*.ps1
tmp/*.sh
tmp/c4-deploy-stage/
tmp/.tg_*
paper/code/
paper_tiny/
nul
_v24_kp.txt
_v24_pt.txt

