# Caches and reproducibility noise
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
*.swp

# Regenerable trained weights (kept as a release artifact in artifacts/, but
# ignored on first commit so reviewers see one canonical binary)
gf256_hard_model_best.pt

# Local data downloads
data/tinyshakespeare.txt.tmp

# Run outputs (reproducible, regenerated by src/gf256_markov_lm_v6.py)
runs/
*.out

# Hermes plans from other sessions
.hermes/plans/*connect-four*

# ---- scratch / probe artefacts -----------------------------------------
# One-off diagnostic scripts written at the repo root or in tmp/ while
# chasing individual bugs. They document HOW a bug was found, which the
# curated regression tests in tmp/ already capture as assertions.
# Keep the curated tests; drop the throwaway probes.
_*.py
tmp/_*.py
tmp/probe_*.py
tmp/debug_*.py
tmp/audit_*.py
tmp/verify_*.py
tmp/eval_*.py
tmp/dump_*.py
tmp/print_*.py
tmp/scan_*.py
tmp/plot_*.py
tmp/*.log
tmp/*.json
tmp/*.txt
tmp/*.npz
tmp/*.pt

# Large data artifacts and per-run logs
*.npz
V1*.TXT
V*_TRAIN_LOG.TXT
PLAN_*.md

# ---- private training corpora -------------------------------------------
# The Connect Four corpus is private: it was generated locally and is NOT
# published. It must never be committed by accident. (27 MB of solver-labelled
# games; the public release ships the *checkpoint*, never the corpus.)
data/corpus_c4_bytes.txt
data/corpus_*.txt
data/*sidecar*
data/*targets*.npy
data/*.npy

# ---- loose probe scripts at the repo root ------------------------------
# One-off diagnostics written while chasing individual questions. The
# curated regression tests in tmp/ capture the durable assertions; these
# throwaway probes are not part of the release surface.
tg_*.py
run_*.sh
check_outcome_rl.py
chk.bat
kill_rl.bat
kill_v7.bat
py.sh
tmp_dbg_threat.py
tmpstatus_*.txt
v18_*.json
worldweb-assets.html
_tmp_*.npy
