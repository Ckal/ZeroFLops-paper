# Caches and reproducibility noise
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
*.swp

# Regenerable trained weights (kept as a release artifact in artifacts/, but
# ignored on first commit so reviewers see one canonical binary)
gf256_hard_model_best.pt

# Local data downloads
data/tinyshakespeare.txt.tmp

# Run outputs (reproducible, regenerated by src/gf256_markov_lm_v6.py)
runs/
*.out

# Hermes plans from other sessions
.hermes/plans/*connect-four*

# ---- scratch / probe artefacts -----------------------------------------
# One-off diagnostic scripts written at the repo root or in tmp/ while
# chasing individual bugs. They document HOW a bug was found, which the
# curated regression tests in tmp/ already capture as assertions.
# Keep the curated tests; drop the throwaway probes.
_*.py
tmp/_*.py
tmp/probe_*.py
tmp/debug_*.py
tmp/audit_*.py
tmp/verify_*.py
tmp/eval_*.py
tmp/dump_*.py
tmp/print_*.py
tmp/scan_*.py
tmp/plot_*.py
tmp/*.log
tmp/*.json
tmp/*.txt
tmp/*.npz
tmp/*.pt

# Large data artifacts and per-run logs
*.npz
V1*.TXT
V*_TRAIN_LOG.TXT
PLAN_*.md
